{
  "name": "rag-motor-traffic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": ".venv\\Scripts\\python.exe -m uvicorn src.api.main:app --host 127.0.0.1 --port 8005 --reload",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": ".venv\\Scripts\\python.exe -m pytest -q"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
